{
  "name": "cuongnx/laravel-mongodb-permission",
  "description": "A flexible and multi-guard Role & Permission system for Laravel 11+ and 12+, using MongoDB and inspired by Spatie.",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Cuong Nguyen",
      "email": "xuancuong220691@gmail.com"
    }
  ],
  "require": {
    "php": "^8.1",
    "laravel/framework": "^11.0 || ^12.0",
    "mongodb/laravel-mongodb": "^5.4"
  },
  "autoload": {
    "psr-4": {
      "CuongNX\\LaravelMongoPermission\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "CuongNX\\LaravelMongoPermission\\Providers\\MongoPermissionServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}